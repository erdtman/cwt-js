{
  "name": "cwt-js",
  "version": "0.5.0",
  "description": "CBOR Web Token (RFC 8392) implementation: create and verify signed, MACed, encrypted and nested CWTs.",
  "author": {
    "name": "Samuel Erdtman",
    "email": "samuel@erdtman.se"
  },
  "license": "MIT",
  "keywords": [
    "cwt",
    "cbor-web-token",
    "rfc8392",
    "cose",
    "cbor",
    "token",
    "IoT",
    "security",
    "signing",
    "encryption",
    "mac"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erdtman/cwt-js.git"
  },
  "bugs": {
    "url": "https://github.com/erdtman/cwt-js/issues"
  },
  "homepage": "https://github.com/erdtman/cwt-js#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "cbor": "^8.1.0",
    "cose-js": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "clean": "rm -rf coverage/ .stryker-tmp/ reports/",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:types": "tsc --noEmit",
    "pretest": "npm run lint && npm run lint:types",
    "test": "node --test \"test/*.js\" \"test/*.mjs\"",
    "watch": "node --test --watch \"test/*.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" \"test/*.js\" \"test/*.mjs\"",
    "coverage:check": "npm run coverage -- --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "mutation": "npx --yes -p @stryker-mutator/core@9 -p typescript@5 stryker run",
    "prepublishOnly": "npm run lint && npm run lint:types && npm test"
  },
  "engines": {
    "node": ">=22"
  }
}
